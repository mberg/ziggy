export struct TileData {
    uri: string,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
}

export struct TrackData {
    uri: string,
    title: string,
    artists: string,
    duration: string,
    current: bool,
}

export enum ScreenKind { grid, detail, now-playing, search, artist, settings, books, book, home }

export struct SpeakerRowData {
    address: string,
    name: string,
    status: string,
}

export enum LoadState { loading, empty, failed, forbidden, limited, ready }

// kind: 0 header, 1 song, 2 album, 3 artist, 4 playlist, 5 book.
export struct SearchRowData {
    kind: int,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
    uri: string,
}

// icon: 0 light, 1 plug, 2 fan.
export struct HomeTileData {
    id: string,
    name: string,
    line: string,
    icon: int,
    on: bool,
    split: bool,
    strip: string,
    // How bright the strip is drawn, 0-100.
    level: int,
    sun: bool,
    selected: bool,
    enabled: bool,
}

export struct HomeSceneData {
    id: string,
    name: string,
    ran: bool,
    enabled: bool,
}
