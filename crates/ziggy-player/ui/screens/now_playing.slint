import { Theme } from "../theme.slint";
import { IconButton } from "../components/icon_button.slint";
import { Scrubber } from "../components/scrubber.slint";

export component NowPlayingScreen inherits Rectangle {
    in property <string> title;
    in property <string> artists;
    in property <image> art;
    in property <bool> has-art;
    in property <bool> playing;
    in property <bool> loading;
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    in property <int> volume;
    in property <bool> shuffle;
    in property <int> repeat;
    // A phone or computer plays over AirPlay: its buttons work, seeking, shuffle and repeat don't.
    in property <bool> airplay;
    callback back();
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback add();
    callback toggle-like();
    callback open-artist();
    callback open-sleep();
    // Minutes left on the sleep timer, as "28 min"; empty when off.
    in property <string> sleep-left;
    // The artist name opens the artist's page.
    in property <bool> has-artist;
    in property <bool> liked;
    // Whether there is a song to add to a playlist.
    in property <bool> can-add;
    background: Theme.backdrop;
    // Absorbs taps so nothing underneath reacts.
    TouchArea {}
    HorizontalLayout {
        padding: 20px;
        spacing: 28px;
        VerticalLayout {
            spacing: 12px;
            alignment: start;
            IconButton {
                icon: @image-url("../icons/back.svg");
                clicked => { root.back(); }
            }
            Rectangle {
                width: 320px;
                height: 320px;
                border-radius: Theme.radius;
                clip: true;
                background: Theme.surface;
                Image {
                    source: @image-url("../icons/note.svg");
                    width: 35%;
                    height: 35%;
                    colorize: Theme.text-dim;
                    visible: !root.has-art;
                }
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.art;
                    image-fit: cover;
                    opacity: root.has-art ? 1 : 0;
                    animate opacity { duration: 200ms; }
                }
            }
        }
        VerticalLayout {
            spacing: 14px;
            alignment: center;
            if root.airplay: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Image {
                    source: @image-url("../icons/airplay.svg");
                    width: 22px;
                    height: 22px;
                    colorize: Theme.accent;
                }
                Text {
                    text: "AirPlay";
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
            // At most two lines: a long title ends in "…" rather than pushing the volume off the
            // screen. A layout gives a wrapped Text all the lines it needs, whatever its
            // max-height, so the frame sets the height.
            Rectangle {
                height: Math.min(title-text.preferred-height, 80px);
                clip: true;
                title-text := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.title;
                    color: Theme.text;
                    font-size: 30px;
                    font-weight: 800;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: top;
                }
            }
            // The artist, with like and add-to-playlist on the same line.
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    artist-text := Text {
                        x: 0;
                        width: Math.min(self.preferred-width, parent.width);
                        text: root.loading ? "Loading…" : root.artists;
                        color: root.has-artist && artist-touch.pressed ? Theme.text : Theme.text-dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    artist-touch := TouchArea {
                        x: 0;
                        width: artist-text.width;
                        enabled: root.has-artist;
                        clicked => { root.open-artist(); }
                    }
                }
                if root.can-add: IconButton {
                    size: 52px;
                    icon: root.liked ? @image-url("../icons/heart.svg") : @image-url("../icons/heart-outline.svg");
                    active: root.liked;
                    clicked => { root.toggle-like(); }
                }
                if root.can-add: IconButton {
                    size: 52px;
                    icon: @image-url("../icons/plus.svg");
                    clicked => { root.add(); }
                }
            }
            Scrubber {
                value: root.progress;
                enabled: !root.airplay;
                changed(v) => { root.seek(v); }
            }
            HorizontalLayout {
                Text { text: root.position-text; color: Theme.text-dim; font-size: Theme.font-small; }
                Rectangle {}
                Text { text: root.duration-text; color: Theme.text-dim; font-size: Theme.font-small; }
            }
            HorizontalLayout {
                alignment: space-between;
                // Hidden, not removed, so the play buttons stay where they are.
                IconButton {
                    visible: !root.airplay;
                    icon: @image-url("../icons/shuffle.svg");
                    active: root.shuffle;
                    clicked => { root.toggle-shuffle(); }
                }
                IconButton {
                    icon: @image-url("../icons/previous.svg");
                    size: 72px;
                    clicked => { root.previous(); }
                }
                IconButton {
                    icon: root.playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                    size: 88px;
                    primary: true;
                    clicked => { root.toggle-play(); }
                }
                IconButton {
                    icon: @image-url("../icons/next.svg");
                    size: 72px;
                    clicked => { root.next(); }
                }
                Rectangle {
                    width: Theme.touch;
                    height: Theme.touch;
                    visible: !root.airplay;
                    IconButton {
                        icon: @image-url("../icons/repeat.svg");
                        active: root.repeat != 0;
                        clicked => { root.cycle-repeat(); }
                    }
                    Text {
                        visible: root.repeat == 2;
                        text: "1";
                        x: parent.width - 16px;
                        y: 6px;
                        font-size: 13px;
                        font-weight: 800;
                        color: Theme.accent;
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                // Level with the slider's line.
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/volume.svg");
                        width: 28px;
                        height: 28px;
                        colorize: Theme.text-dim;
                    }
                }
                Scrubber {
                    value: root.volume / 100;
                    changed(v) => { root.set-volume(Math.round(v * 100)); }
                }
                // Sleep timer at the end of the volume row: tap to choose, tap again to cancel.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: moon-row.preferred-width;
                        height: 48px;
                        border-radius: 24px;
                        background: moon-touch.pressed ? Theme.surface-hi : transparent;
                        accessible-role: button;
                        accessible-label: "Sleep timer";
                        accessible-action-default => { root.open-sleep(); }
                        moon-row := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/moon.svg");
                                    width: 24px;
                                    height: 24px;
                                    colorize: root.sleep-left == "" ? Theme.text-dim : Theme.accent;
                                }
                            }
                            if root.sleep-left != "": Text {
                                text: root.sleep-left;
                                color: Theme.accent;
                                font-size: Theme.font-small;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                        moon-touch := TouchArea {
                            clicked => { root.open-sleep(); }
                        }
                    }
                }
            }
        }
    }
}
