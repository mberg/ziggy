import "fonts/Nunito-Bold.ttf";
import "fonts/Nunito-ExtraBold.ttf";
import { Theme } from "theme.slint";
import { TileData, TrackData, ScreenKind, LoadState, SearchRowData, SpeakerRowData } from "types.slint";
import { Rail } from "components/rail.slint";
import { MiniPlayer } from "components/mini_player.slint";
import { Banner } from "components/banner.slint";
import { VoicePill } from "components/voice_pill.slint";
import { GridScreen } from "screens/grid.slint";
import { DetailScreen } from "screens/detail.slint";
import { NowPlayingScreen } from "screens/now_playing.slint";
import { IdleOverlay } from "screens/idle.slint";
import { AuthNeededScreen, PairScreen } from "screens/auth_needed.slint";
import { SearchScreen } from "screens/search.slint";
import { ArtistScreen } from "screens/artist.slint";
import { Keyboard } from "components/keyboard.slint";
import { PlaylistPicker } from "components/picker.slint";
import { NameDialog } from "components/name_dialog.slint";
import { ConfirmDelete } from "components/confirm_dialog.slint";
import { SettingsScreen } from "screens/settings.slint";
import { BooksScreen } from "screens/books.slint";
import { BookScreen, ChapterData } from "screens/book.slint";

export { TileData, TrackData, ScreenKind, LoadState, SearchRowData, SpeakerRowData, Theme, ChapterData }

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    title: "Ziggy";
    background: Theme.backdrop;
    default-font-family: "Nunito";

    in property <ScreenKind> screen;
    in property <int> section;
    in property <string> grid-title;
    in property <[TileData]> tiles;
    in property <LoadState> grid-state;
    in property <TileData> detail;
    in property <[TrackData]> detail-tracks;
    in property <LoadState> detail-state;
    in property <bool> mini-visible;
    in property <string> track-title;
    in property <string> track-artists;
    in property <image> track-art;
    in property <bool> track-has-art;
    in property <bool> playing;
    in property <bool> loading;
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    in property <int> volume;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <string> banner;
    // Voice replies show at the bottom, where "Listening…" was.
    in property <bool> banner-at-bottom;
    // "Listening…" or "Working on it…" during a voice request; empty otherwise.
    in property <string> voice-status;
    in property <bool> voice-listening;
    in property <bool> voice-enabled;
    callback listen();
    in property <int> display-mode;
    in property <string> clock;
    in property <bool> show-clock;
    in property <bool> auth-needed;
    in property <bool> pairing-needed;
    in property <string> account-name;
    in property <string> account-id;
    in property <string> device-name;
    in property <string> output-name;
    in property <bool> on-speaker;
    in property <bool> on-sonos;
    in property <[SpeakerRowData]> sonos-rooms;
    in property <bool> speaker-connected;
    in property <bool> bluetooth;
    in property <bool> scanning;
    in property <[SpeakerRowData]> speakers;
    in property <string> settings-message;
    in property <string> bluetooth-note;
    in property <string> temperature;
    in property <bool> temperature-hot;
    in property <string> wifi;
    in property <bool> wifi-weak;
    in property <bool> powering-off;
    in property <bool> restarting;
    in property <string> search-query;
    in property <bool> keyboard-open;
    in property <[SearchRowData]> search-rows;
    in property <LoadState> search-state;
    in property <string> search-note;
    in property <int> search-filter;
    in property <TileData> artist;
    in property <[TileData]> artist-albums;
    in property <LoadState> artist-state;
    in property <bool> detail-editable;
    in property <bool> detail-editing;
    in property <bool> detail-can-add;
    in property <string> detail-summary;
    in property <bool> detail-saveable;
    in property <bool> detail-saved;
    in property <bool> detail-artist-link;
    in property <bool> artist-followed;
    in property <string> artist-back-label;
    in property <string> now-track-uri;
    in property <bool> now-liked;
    in property <bool> now-has-artist;
    in property <string> sleep-left;
    in property <int> sleep-minutes;
    callback set-theme(int);
    in property <bool> list-view;
    in property <bool> recent-chips;
    in property <bool> books-enabled;
    in property <string> books-query;
    in property <[SearchRowData]> books-rows;
    in property <LoadState> books-state;
    in property <string> books-message;
    in property <string> book-title;
    in property <string> book-author;
    in property <string> book-narrator;
    in property <image> book-cover;
    in property <bool> book-has-cover;
    in property <string> book-info;
    in property <[ChapterData]> book-chapters;
    in property <LoadState> book-state;
    in property <string> books-url;
    in property <string> books-user;
    in property <string> books-settings-message;
    in property <bool> can-create-playlist;
    in property <bool> recent-songs;
    in property <[TileData]> recent-song-rows;
    in property <bool> picker-open;
    in property <[TileData]> picker-playlists;
    in property <bool> name-open;
    in property <string> name-title;
    in property <string> name-text;
    in property <string> confirm-delete;

    callback show-section(int);
    callback open-collection(string);
    callback back();
    callback open-now-playing();
    callback play-collection(string, bool);
    callback play-track(string, int);
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback touched();
    callback key-pressed(string);
    callback backspace();
    callback clear-search();
    callback open-keyboard();
    callback close-keyboard();
    callback close-search();
    callback set-search-filter(int);
    callback open-artist(string);
    callback play-artist(string);
    callback play-song(string);
    callback keyboard-done();
    callback toggle-like();
    callback open-playing-artist();
    callback open-album-artist(string);
    callback open-sleep-timer();
    callback set-sleep-length(int);
    callback toggle-list-view();
    callback set-recent-songs(bool);
    callback open-book(string);
    callback set-books-enabled(bool);
    callback edit-books-server();
    callback books-sign-in();
    callback books-sign-out();
    callback create-playlist();
    callback play-recent(int);
    callback toggle-save-album(string);
    callback toggle-follow(string);
    callback pick-liked();
    callback rename-device();
    callback find-speakers();
    callback power-off();
    callback connect-speaker(string);
    callback use-jack();
    callback choose-sonos(string);
    callback forget-speaker();
    callback open-picker(string);
    callback close-picker();
    callback pick-playlist(string);
    callback new-playlist();
    callback cancel-name();
    callback edit-playlist(string);
    callback finish-editing();
    callback rename-playlist();
    callback ask-delete();
    callback confirm-delete-playlist();
    callback cancel-delete();
    callback remove-track(int);
    callback move-track(int, int);

    property <length> content-height: root.mini-visible ? root.height - Theme.mini-height : root.height;

    Rail {
        x: 0;
        y: 0;
        height: root.height;
        // Search uses the whole screen.
        visible: root.screen != ScreenKind.search;
        selected: root.section;
        books: root.books-enabled;
        select(i) => { root.show-section(i); }
    }
    GridScreen {
        x: Theme.rail-width;
        y: 0;
        width: root.width - Theme.rail-width;
        height: root.content-height;
        visible: root.screen == ScreenKind.grid;
        title: root.grid-title;
        tiles: root.tiles;
        state: root.grid-state;
        open(uri) => { root.open-collection(uri); }
        list-view: root.list-view;
        toggle-layout => { root.toggle-list-view(); }
        recent-chips: root.recent-chips;
        can-create: root.can-create-playlist;
        create => { root.create-playlist(); }
        recent-songs: root.recent-songs;
        songs: root.recent-song-rows;
        set-recent-songs(b) => { root.set-recent-songs(b); }
        play-recent(i) => { root.play-recent(i); }
    }
    DetailScreen {
        x: Theme.rail-width;
        y: 0;
        width: root.width - Theme.rail-width;
        height: root.content-height;
        visible: root.screen == ScreenKind.detail;
        header: root.detail;
        tracks: root.detail-tracks;
        state: root.detail-state;
        back => { root.back(); }
        play(shuffle) => { root.play-collection(root.detail.uri, shuffle); }
        play-track(i) => { root.play-track(root.detail.uri, i); }
        editable: root.detail-editable;
        editing: root.detail-editing;
        can-add: root.detail-can-add;
        summary: root.detail-summary;
        saveable: root.detail-saveable;
        saved: root.detail-saved;
        artist-link: root.detail-artist-link;
        open-artist => { root.open-album-artist(root.detail.uri); }
        toggle-save => { root.toggle-save-album(root.detail.uri); }
        add(uri) => { root.open-picker(uri); }
        edit => { root.edit-playlist(root.detail.uri); }
        finish-editing => { root.finish-editing(); }
        rename => { root.rename-playlist(); }
        delete => { root.ask-delete(); }
        remove(i) => { root.remove-track(i); }
        move-track(from, to) => { root.move-track(from, to); }
    }
    SearchScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.content-height;
        visible: root.screen == ScreenKind.search;
        query: root.search-query;
        keyboard: root.keyboard-open;
        keyboard-height: kb.height;
        rows: root.search-rows;
        state: root.search-state;
        note: root.search-note;
        open(uri) => { root.open-collection(uri); }
        open-artist(uri) => { root.open-artist(uri); }
        play-song(uri) => { root.play-song(uri); }
        add-song(uri) => { root.open-picker(uri); }
        clear => { root.clear-search(); }
        open-keyboard => { root.open-keyboard(); }
        voice: root.voice-enabled;
        listen => { root.listen(); }
        close => { root.close-search(); }
        filter: root.search-filter;
        set-filter(i) => { root.set-search-filter(i); }
    }
    BooksScreen {
        x: Theme.rail-width;
        y: 0;
        width: root.width - Theme.rail-width;
        height: root.content-height;
        visible: root.screen == ScreenKind.books;
        query: root.books-query;
        keyboard: root.keyboard-open;
        keyboard-height: kb.height;
        rows: root.books-rows;
        state: root.books-state;
        message: root.books-message;
        open-book(id) => { root.open-book(id); }
        open-keyboard => { root.open-keyboard(); }
    }
    BookScreen {
        x: Theme.rail-width;
        y: 0;
        width: root.width - Theme.rail-width;
        height: root.content-height;
        visible: root.screen == ScreenKind.book;
        title: root.book-title;
        author: root.book-author;
        narrator: root.book-narrator;
        cover-image: root.book-cover;
        has-cover: root.book-has-cover;
        info: root.book-info;
        chapters: root.book-chapters;
        state: root.book-state;
    }
    SettingsScreen {
        x: Theme.rail-width;
        y: 0;
        width: root.width - Theme.rail-width;
        height: root.content-height;
        visible: root.screen == ScreenKind.settings;
        account-name: root.account-name;
        account-id: root.account-id;
        device-name: root.device-name;
        output: root.output-name;
        on-speaker: root.on-speaker;
        on-sonos: root.on-sonos;
        sonos-rooms: root.sonos-rooms;
        choose-sonos(uuid) => { root.choose-sonos(uuid); }
        speaker-connected: root.speaker-connected;
        bluetooth: root.bluetooth;
        scanning: root.scanning;
        speakers: root.speakers;
        message: root.settings-message;
        bluetooth-note: root.bluetooth-note;
        temperature: root.temperature;
        temperature-hot: root.temperature-hot;
        wifi: root.wifi;
        wifi-weak: root.wifi-weak;
        restarting: root.restarting;
        rename-device => { root.rename-device(); }
        find-speakers => { root.find-speakers(); }
        power-off => { root.power-off(); }
        connect-speaker(address) => { root.connect-speaker(address); }
        use-jack => { root.use-jack(); }
        forget-speaker => { root.forget-speaker(); }
        sleep-minutes: root.sleep-minutes;
        set-sleep-length(m) => { root.set-sleep-length(m); }
        set-theme(i) => { root.set-theme(i); }
        books-enabled: root.books-enabled;
        books-url: root.books-url;
        books-user: root.books-user;
        books-message: root.books-settings-message;
        set-books-enabled(b) => { root.set-books-enabled(b); }
        edit-books-server => { root.edit-books-server(); }
        books-sign-in => { root.books-sign-in(); }
        books-sign-out => { root.books-sign-out(); }
    }
    ArtistScreen {
        x: Theme.rail-width;
        y: 0;
        width: root.width - Theme.rail-width;
        height: root.content-height;
        visible: root.screen == ScreenKind.artist;
        header: root.artist;
        albums: root.artist-albums;
        state: root.artist-state;
        followed: root.artist-followed;
        back-label: root.artist-back-label;
        toggle-follow => { root.toggle-follow(root.artist.uri); }
        list-view: root.list-view;
        toggle-layout => { root.toggle-list-view(); }
        back => { root.back(); }
        play => { root.play-artist(root.artist.uri); }
        open(uri) => { root.open-collection(uri); }
    }

    if root.mini-visible: MiniPlayer {
        x: root.screen == ScreenKind.search ? 0 : Theme.rail-width;
        y: root.height - Theme.mini-height;
        width: root.width - self.x;
        title: root.track-title;
        artists: root.track-artists;
        art: root.track-art;
        has-art: root.track-has-art;
        playing: root.playing;
        open => { root.open-now-playing(); }
        toggle-play => { root.toggle-play(); }
    }
    NowPlayingScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: root.screen == ScreenKind.now-playing;
        title: root.track-title;
        artists: root.track-artists;
        art: root.track-art;
        has-art: root.track-has-art;
        playing: root.playing;
        loading: root.loading;
        progress: root.progress;
        position-text: root.position-text;
        duration-text: root.duration-text;
        volume: root.volume;
        shuffle: root.shuffle;
        repeat: root.repeat;
        back => { root.back(); }
        toggle-play => { root.toggle-play(); }
        next => { root.next(); }
        previous => { root.previous(); }
        seek(v) => { root.seek(v); }
        set-volume(v) => { root.set-volume(v); }
        toggle-shuffle => { root.toggle-shuffle(); }
        cycle-repeat => { root.cycle-repeat(); }
        can-add: root.now-track-uri != "";
        add => { root.open-picker(root.now-track-uri); }
        liked: root.now-liked;
        toggle-like => { root.toggle-like(); }
        has-artist: root.now-has-artist;
        open-artist => { root.open-playing-artist(); }
        sleep-left: root.sleep-left;
        open-sleep => { root.open-sleep-timer(); }
    }
    if root.picker-open: PlaylistPicker {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        playlists: root.picker-playlists;
        pick(uri) => { root.pick-playlist(uri); }
        new-playlist => { root.new-playlist(); }
        pick-liked => { root.pick-liked(); }
        close => { root.close-picker(); }
    }
    if root.name-open: NameDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - kb.height;
        title: root.name-title;
        text: root.name-text;
        save => { root.keyboard-done(); }
        cancel => { root.cancel-name(); }
    }
    kb := Keyboard {
        x: 0;
        y: root.height - self.height;
        width: root.width;
        visible: root.keyboard-open;
        shown: root.keyboard-open;
        key(text) => { root.key-pressed(text); }
        backspace => { root.backspace(); }
        done => { root.keyboard-done(); }
    }
    if root.confirm-delete != "": ConfirmDelete {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        name: root.confirm-delete;
        confirm => { root.confirm-delete-playlist(); }
        cancel => { root.cancel-delete(); }
    }
    // Shutting down: a plain screen saying when it's safe to unplug.
    if root.powering-off: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000;
        TouchArea {}
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            Text {
                text: "Turning off…";
                color: #ffffff;
                font-size: Theme.font-title;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: "Wait until the green light on the Pi stops blinking, then unplug it.\nTo turn it back on, plug it in again.";
                color: #bbbbbb;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }
        }
    }
    if root.banner != "" && root.voice-status == "": Banner {
        x: (root.width - self.width) / 2;
        y: root.banner-at-bottom ? root.height - self.height - 16px : 12px;
        text: root.banner;
    }
    if root.voice-status != "": VoicePill {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px;
        text: root.voice-status;
        listening: root.voice-listening;
    }
    if root.pairing-needed && !root.auth-needed: PairScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        device-name: root.device-name;
    }
    if root.auth-needed: AuthNeededScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
    IdleOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        mode: root.display-mode;
        clock: root.clock;
        show-clock: root.show-clock;
        touched => { root.touched(); }
    }
}
